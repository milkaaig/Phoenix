@model Phoenix.Data.Post;  
@using Phoenix.Data  

@*  Post data will be prompted and tied with Data.Post *@  

@{  
    ViewData["Title"] = "Create Post";  
    Layout = "~/Views/Shared/_Layout.cshtml";  
    var category = new List<String> { "Technology", "Business", "Health" };  
}  

<div class="container mt-4">  

    <h2>Create Post</h2>  

    <form asp-controller="AddPost" asp-action="SubmitPost" method="post">  
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>  

        <div class="form-group">  
            <label asp-for="Title" class="control-label"></label>  
            <input asp-for="Title" class="form-control" type="text" placeholder="Enter Post title" />  
            <span asp-validation-for="Title" class="text-danger"></span>  
        </div>  
        <div class="form-group">  
            <label asp-for="Description" class="control-label"></label>  
            <textarea asp-for="Description" class="form-control" placeholder="Enter a short description"></textarea>  
            <span asp-validation-for="Description" class="text-danger"></span>  
        </div>  

        <div class="form-group">  
            <label asp-for="date" class="control-label"></label>  
            <input asp-for="date" class="form-control" type="date" placeholder="Select a date" />  
            <span asp-validation-for="date" class="text-danger"></span>  
        </div>  

        <div class="form-group">  
            <label asp-for="Category" class="control-label"></label>  
            <select asp-for="Category" class="form-control">  
                @foreach (var cat in category)  
                {  
                    <option value="@cat">@cat</option>  
                }  
            </select>  
            <span asp-validation-for="Category" class="text-danger"></span>  
        </div>  

        <div class="form-group">  
            <label asp-for="Author" class="control-label"></label>
            <input asp-for="Author" class="form-control" type="text" placeholder="Enter your name" />

            <span asp-validation-for="Author" class="text-danger"></span>  
        </div>  

        <div class="form-group">   
            <input type="submit" value="Submit" asp-controller="AddPost" asp-action="SubmitPost" method="post" class="btn btn-primary" />  
            
        </div>
        @* <div class="form-group">  
            <a  asp-controller="AddPost" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
        </div> *@
        <div class="form-group">  
            <a asp-controller="AddPost" asp-action="Delete"  asp-route-id="@Model.Id" class="btn btn-secondary">Delete</a>
        </div>


    </form>  

</div>  

@section Scripts {  
    <partial name="_ValidationScriptsPartial" />  
}
