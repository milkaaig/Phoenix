@model IEnumerable<Phoenix.Data.Post>

@{
    ViewData["Title"] = "All Posts";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasPosts = ViewBag.HasPosts as bool? ?? false;
}

<div class="container mt-4">
    <h2>All Posts</h2>
    <div style="max-height: 400px; overflow-y: auto;">
        <table class="table table-striped custom-table-spacing">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>View</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Author</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var post in Model)
            {
                <tr>
                    <td>@post.Title</td>
                    <td>
                        <a asp-controller="AddPost" asp-action="Post" asp-route-id="@post.Id" class="btn btn-outline-info btn-sm">
                            View Post
                        </a>
                    </td>
                    <td>@post.Category</td>
                    <td>@post.date.ToString("yyyy-MM-dd")</td>
                    <td>@post.Author</td>
                    <td>
                        <form asp-action="Delete" asp-controller="AddPost" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@post.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this post?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (hasPosts)
    {
        <form asp-action="DeleteAll" asp-controller="AddPost" method="post" onsubmit="return confirm('Delete ALL posts?');" class="mb-5">
            <button type="submit" class="btn btn-outline-danger mt-3">Delete All Posts</button>
        </form>
    }
</div>

