@model IEnumerable<Phoenix.Data.Post>
@using Phoenix.Data

@{
    ViewData["Title"] = "Posts";
    var postsList = Model?.ToList() ?? new List<Phoenix.Data.Post>();
    int descLimit = 100; // Character limit for description preview
    Func<string, int, string> Truncate = (desc, limit) =>
        string.IsNullOrEmpty(desc) ? "" : (desc.Length > limit ? desc.Substring(0, limit) + "..." : desc);

    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var isInitialLoad = ViewBag.IsInitialLoad as bool? ?? true;
    var search = Context.Request.Query["search"];
    var category = Context.Request.Query["category"];
    var sort = Context.Request.Query["sort"];
}

<div class="container mt-4">
    <!-- Search Box -->
    <form method="get" asp-controller="AddPost" asp-action="GetPosts" class="mb-4">
        <div class="row">
            <div class="col-md-6 mx-auto">
                <input id="searchBox" name="search" type="text" class="form-control" 
                       placeholder="Search posts by title, category, or author..." 
                       value="@(ViewContext.HttpContext.Request.Query["search"])" />
            </div>
        </div>
    </form>

    <!-- Carousel -->
    @if (postsList.Any())
    {
        <div class="w-100 d-flex justify-content-center mb-5">
            <div id="postsCarousel" class="carousel slide" data-bs-ride="carousel" >
                <div class="carousel-inner">
                    @for (int i = 0; i < postsList.Count; i++)
                    {
                        var post = postsList[i];
                        <div class="carousel-item @(i == 0 ? "active" : "") post-carousel-item"
                             data-title="@post.Title"
                             data-category="@post.Category"
                             data-author="@post.Author">
                            <a asp-controller="AddPost" asp-action="Post" asp-route-id="@post.Id" class="text-decoration-none text-dark">
                                <div class="card carousel-card">
                                    <div class="card-body carousel-card-body">
                                        <h4 class="card-title">@post.Title</h4>
                                        <h6 class="card-subtitle mb-2 text-muted">
                                            @post.Category &bull; @post.date.ToString("yyyy-MM-dd")
                                        </h6>
                                        <p class="card-text carousel-desc-preview">@post.Description</p>
                                        <footer class="blockquote-footer mt-3">By @post.Author</footer>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#postsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#postsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">No posts available.</div>
    }

    <!-- Filter and Sort  -->
    <form method="get" asp-controller="AddPost" asp-action="GetPosts" class="mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="category" class="form-label">Category</label>
                <select id="category" name="category" class="form-select" onchange="this.form.submit()">
                    <option value="">All</option>
                    @foreach (var cat in (List<string>)ViewBag.Categories)
                    {
                        <option value="@cat" selected="@(ViewContext.HttpContext.Request.Query["category"] == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="sort" class="form-label">Sort By</label>
                <select id="sort" name="sort" class="form-select" onchange="this.form.submit()">
                    <option value="latest" selected ="@(ViewContext.HttpContext.Request.Query["sort"] == "latest")  ">Latest</option>
                    <option value="oldest" selected="@(ViewContext.HttpContext.Request.Query["sort"] == "oldest")">Oldest</option>
                </select>
            </div>
        </div>
    </form>




    <!-- Cards Grid -->
    <div class="row" id="postsCards">
        @foreach (var post in postsList)
        {
            <div class="col-md-4 mb-4 post-card"
                 data-title="@post.Title"
                 data-category="@post.Category"
                 data-author="@post.Author">
                <a asp-controller="AddPost" asp-action="Post" asp-route-id="@post.Id" class="text-decoration-none text-dark">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@post.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">
                                @post.Category &bull; @post.date.ToString("yyyy-MM-dd")
                            </h6>
                            <div class="desc-preview">
                                @Truncate(post.Description, descLimit)
                            </div>
                            <footer class="blockquote-footer mt-3">By @post.Author</footer>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    @if (!isInitialLoad && totalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4  ">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("GetPosts", new { search = search, category = category, sort = sort, page = currentPage - 1 })"
                       tabindex="-1">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("GetPosts", new { search = search, category = category, sort = sort, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("GetPosts", new { search = search, category = category, sort = sort, page = currentPage + 1 })">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>